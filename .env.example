# Documentation Agent Environment Configuration

# ======================
# AI Agent Configuration
# ======================

# OpenAI API Key (required for agentic pipeline)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# AI Model Endpoint (default: OpenAI)
# Change this if using Azure OpenAI or other providers
SPECKIT_MODEL_ENDPOINT=https://api.openai.com/v1/chat/completions

# AI Model Name (default: gpt-4o-mini)
# Options: gpt-4o-mini, gpt-4o, gpt-4-turbo, gpt-3.5-turbo
# gpt-4o-mini recommended for cost/quality balance
SPECKIT_MODEL_NAME=gpt-4o-mini

# ======================
# How AI Enhancement Works
# ======================
#
# When OPENAI_API_KEY is set:
#   ✅ AI analyzes markdown for intelligent parsing
#   ✅ Generates better titles and abstracts
#   ✅ Smart section classification
#   ✅ Context-aware content understanding
#
# When OPENAI_API_KEY is NOT set:
#   ❌ Falls back to rule-based parsing
#   ❌ Uses heuristics for title/abstract
#   ❌ Pattern matching for classification
#
# The system works in both modes!

# ======================
# Usage
# ======================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Add your OpenAI API key
#
# 3. Start services:
#    docker-compose up -d
#
# 4. The backend will automatically use AI if key is present
