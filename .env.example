# Speckit Auto-AI - backend environment configuration
#
# Everything here is OPTIONAL. With no .env at all, the Docker stack starts
# with working defaults (dev-key + PostgreSQL) and the extension supplies the
# AI, so a fresh clone runs without editing anything.
#
# Usage:
#   1. cp .env.example .env          (Windows: Copy-Item .env.example .env)
#   2. Fill in whatever you want to override.
#   3. .\START-EVERYTHING.ps1        - it passes this file to Compose.
#      Running Compose by hand? Point it at this file explicitly, because
#      Compose only auto-loads a .env next to the compose file (infra/.env):
#        cd infra
#        docker compose --env-file ../.env up -d --build

# ======================
# Backend / API
# ======================

# Shared secret the VS Code extension and frontend send as
# "Authorization: Bearer <key>". If you change it, also change:
#   - VS Code setting  speckit.apiKey
#   - frontend/.env.development  VITE_API_KEY
SPECKIT_EXT_API_KEY=dev-key

# Where generated PDFs are written inside the container. The compose file
# bind-mounts <repo>/pdf-output to this path, so leave it alone unless you
# also change that mount.
DOC_OUTPUT_DIR=/tmp/doc-output

# "true"  -> PostgreSQL (the db service in infra/docker-compose.yml)
# "false" -> SQLite file (DOC_AGENT_DB_PATH, defaults to ./doc_agent.sqlite3)
# Postgres is the default; if the connection fails the backend logs the error
# and falls back to SQLite rather than crashing.
USE_POSTGRES=true

# ======================
# Server-side AI (optional)
# ======================
#
# Only used by the backend's own transform path. The normal flow does NOT need
# this: the VS Code extension uses whatever AI is already active in your IDE
# (Copilot/Claude/Ollama/...) and the backend just validates and renders.
# Without a key the backend falls back to rule-based parsing.

# OPENAI_API_KEY=sk-your-api-key-here
SPECKIT_MODEL_ENDPOINT=https://api.openai.com/v1/chat/completions
SPECKIT_MODEL_NAME=gpt-4o-mini

# Set to "false" to force deterministic rule-based transformation server-side.
USE_AI_TRANSFORM=true
