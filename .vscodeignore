# The VSIX ships: out/ (compiled host), server/ (Python source), bin/ (bundled
# interpreter + typst), resources/, and the root metadata files. Everything
# else in this repo is development material, and `vsce ls` should be checked
# before every package to confirm that.

# Product specifications and local build output. Neither is read at runtime.
specs/**
pdf-output/**
*.ps1

# The Linux interpreter ships terminfo entries whose paths differ only in case -
# terminfo/e/eterm-color beside terminfo/E/Eterm-color - and the VSIX format
# forbids that, so packaging that target failed outright. Nothing in the backend
# drives a terminal, so they are dropped rather than renamed.
bin/*/python/share/terminfo/**

# Extension host sources - out/ is what runs. shared/ is compiled into it.
src/**
shared/**
tsconfig.json
**/*.ts.map
**/*.map

# The webview ships as its built bundle. Its sources, dependencies and build
# config are all several times the size of the output and none of it is read
# at runtime.
webview-ui/src/**
webview-ui/node_modules/**
webview-ui/package.json
webview-ui/package-lock.json
webview-ui/tsconfig.json
webview-ui/tsconfig.tsbuildinfo
webview-ui/vite.config.ts
webview-ui/tailwind.config.js
webview-ui/postcss.config.js

# Python tests and caches travel with server/ otherwise.
server/tests/**
**/__pycache__/**
**/*.pyc
.pytest_cache/**

# Extension-host tests. They exercise the host in isolation and have no job
# inside a shipped extension.
out/src/test/**

# Tooling scaffolding. vsce ignores .gitignore entirely, so every one of these
# has to be named here or it rides along - which is what `vsce ls` is for.
.specify/**
.kiro/**
.speckit-auto-ai/**
.claude/**
.scratch-*/**
skills-lock.json

# Repo tooling and docs that are not user-facing.
.github/**
.vscode/**
.venv/**
scripts/**
graphify-out/**
node_modules/**
CLAUDE.md
CONTRIBUTING.md
DEVELOPMENT.md
runtimes.lock.json
.gitignore
.smoke-storage/**
