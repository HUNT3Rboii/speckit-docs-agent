# Anchored to repo root (leading /): an unanchored "lib/" also matched
# frontend/src/lib/ (real source, holds the shadcn cn() helper every UI
# component imports) at any depth, silently keeping it out of git the
# whole time - a fresh clone built fine locally but broke for anyone else.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.virtualenv

# Local environment overrides - these hold real API keys (see .env.example).
# .env.example itself stays tracked; it is the template.
.env
.env.*
!.env.example

